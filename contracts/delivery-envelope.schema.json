{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-communications:runtime-envelope:v1",
  "title": "ACS Runtime Delivery Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "deliveryId", "kind", "from", "to", "provenance"],
  "properties": {
    "schema": {
      "const": "urn:agent-communications:runtime-envelope:v1"
    },
    "deliveryId": {
      "type": "string",
      "pattern": "^int_[0-9A-Za-z_-]+$"
    },
    "kind": {
      "enum": ["a2a-message", "a2a-task-event"]
    },
    "from": {
      "$ref": "#/$defs/agentRef"
    },
    "to": {
      "$ref": "#/$defs/agentRef"
    },
    "task": {
      "$ref": "#/$defs/taskRef"
    },
    "message": {
      "$ref": "#/$defs/message"
    },
    "event": {
      "$ref": "#/$defs/event"
    },
    "reply": {
      "$ref": "#/$defs/reply"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "trustedForPermissions"],
      "properties": {
        "authority": {
          "const": "peer-agent"
        },
        "trustedForPermissions": {
          "const": false
        }
      }
    },
    "payloadHash": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "a2a-message"
          }
        }
      },
      "then": {
        "required": ["task", "message", "reply"]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "a2a-task-event"
          }
        }
      },
      "then": {
        "required": ["task", "event"]
      }
    }
  ],
  "$defs": {
    "agentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentId", "name"],
      "properties": {
        "agentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "taskRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contextId", "state"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "textPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "maxLength": 65536
        },
        "mediaType": {
          "enum": ["text/plain", "text/markdown"]
        }
      }
    },
    "uriPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri"],
      "properties": {
        "kind": {
          "const": "uri"
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 4096
        },
        "name": {
          "type": "string",
          "maxLength": 256
        },
        "mediaType": {
          "type": "string",
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },
    "dataPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "data", "mediaType"],
      "properties": {
        "kind": {
          "const": "data"
        },
        "data": {},
        "mediaType": {
          "type": "string",
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "part": {
      "oneOf": [
        {
          "$ref": "#/$defs/textPart"
        },
        {
          "$ref": "#/$defs/uriPart"
        },
        {
          "$ref": "#/$defs/dataPart"
        }
      ]
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parts"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/part"
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence"],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "type": "string",
          "maxLength": 64
        },
        "summary": {
          "type": "string",
          "maxLength": 65536
        },
        "parts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/part"
          }
        }
      }
    },
    "reply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completeTool", "failTool", "requestInputTool", "taskId"],
      "properties": {
        "completeTool": {
          "const": "acs_task_complete"
        },
        "failTool": {
          "const": "acs_task_fail"
        },
        "requestInputTool": {
          "const": "acs_task_request_input"
        },
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
