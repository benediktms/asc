{
  "name": "agent-communications-service",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun build apps/acs/src/main.ts --compile --outfile dist/acs",
    "boundaries": "bun scripts/check-imports.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run boundaries && bun run enums:check && bun run codex:check && bun test",
    "codex:check": "bun scripts/generate-codex-protocol.ts --check",
    "enums:check": "bun scripts/check-enums.ts",
    "format": "oxfmt . '!packages/codex-protocol-generated/**'",
    "format:check": "oxfmt --check . '!packages/codex-protocol-generated/**'",
    "generate:codex": "bun scripts/generate-codex-protocol.ts",
    "lint": "oxlint -D correctness -D suspicious -D perf -D typescript/no-explicit-any -D typescript/prefer-enum-initializers -A no-await-in-loop -A no-underscore-dangle --import-plugin --deny-warnings --ignore-pattern packages/codex-protocol-generated/** .",
    "release": "bun scripts/build-release.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:a2a-tck": "bun scripts/run-a2a-tck.ts",
    "test:codex-real": "ACS_REAL_CODEX=1 bun test tests/real-codex.test.ts",
    "test:codex-model": "ACS_REAL_CODEX_MODEL=1 bun test tests/real-codex.test.ts",
    "probe:codex-ownership": "bun scripts/probe-codex-ownership.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@openai/codex": "0.153.2",
    "@types/bun": "1.2.21",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "5.9.2"
  }
}
